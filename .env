# ── Frontend (React) ──────────────────────────────────────
# These are picked up by Create React App at build time.
# Prefix all frontend env vars with REACT_APP_

REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_N8N_URL=http://localhost:5678

# ── Backend (Express) ─────────────────────────────────────
# SQLite is used by default (no configuration needed)
# Data is stored in recipients.db file in the project root

PORT=3001